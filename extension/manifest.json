{
  "manifest_version": 3,
  "name": "Tiny Browser",
  "version": "0.2.0",
  "description": "Browser actuator for Cursor AI — screenshot, click, type, scroll, navigate",
  "permissions": ["activeTab", "scripting", "tabs", "alarms", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://localhost:7331 http://127.0.0.1:7331"
  },
  "action": {
    "default_title": "Tiny Browser MCP",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png"
  }
}
